# Ollama hosted in Kaggle; this is the active provider.
MODEL_PROVIDER=ollama

# Optional OpenRouter alternative. Never commit your real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=elorian/glimpse
OPENROUTER_MAX_TOKENS=8192

# Kaggle tunnel API root and model discovery endpoint.
OLLAMA_BASE_URL=https://sunglasses-ala-leader-ribbon.trycloudflare.com
OLLAMA_MODEL=https://sunglasses-ala-leader-ribbon.trycloudflare.com/api/tags
# Default model; use /models to see available models and /model ollama:<name>
# to select another one.
OLLAMA_CHAT_MODEL=qwen3:8b

# Optional: enables web_search and web_extract MCP tools.
TAVILY_API_KEY=
